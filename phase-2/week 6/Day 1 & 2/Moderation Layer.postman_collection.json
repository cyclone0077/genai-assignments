            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/moderate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "moderate"
              ]
            },
            "description": "The single most safety-critical assertion in the system: even though this text ALSO contains PII, the precedence table (Architecture.md §3.2) says any SECRET match always wins -> decision is BLOCK, sanitizedContent is null."

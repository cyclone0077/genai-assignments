            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/file/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "file",
                "validate"
              ]
            },
            "description": "Checks extension + declared MIME + actual magic bytes all agree, and (for .txt/.csv/.pdf/.docx) extracts text. Response includes valid, extractedText, and errors[] if any of the three checks disagree.\n\nTip: to see it FAIL, rename a .png file to .txt and upload it — the magic bytes won't match, giving MAGIC_BYTE_MISMATCH."
          },
          "response": []
        }
      ]
